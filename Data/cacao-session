#!/bin/sh
# Starts the Cacao session.
#
#   cacao-session         CacaoWindowServer as the compositor
#   cacao-session --sway  sway as the compositor, with a config that floats
#                         every window: the stand-in from before the window
#                         server, kept as a fallback

export XDG_CURRENT_DESKTOP=Cacao
export XDG_SESSION_DESKTOP=cacao
export XDG_SESSION_TYPE=wayland

case "$1" in
--sway)
    shift
    CONFIG="${CACAO_SWAY_CONFIG:-/usr/share/cacao/sway/config}"
    exec sway --config "$CONFIG" "$@"
    ;;
--start-shell)
    # The window server has already given D-Bus activated services the
    # session's Wayland display and desktop name.
    CacaoSettings &
    # The desktop's wallpaper and icons, from Files (swift-linux-core-apps).
    files --desktop &
    CacaoMenuBar &
    CacaoDock &
    wait
    ;;
*)
    # The window server's option before it became the default.
    [ "$1" = --window-server ] && shift
    # The window server runs the shell once its display is up.
    exec CacaoWindowServer -s "\"$0\" --start-shell" "$@"
    ;;
esac
